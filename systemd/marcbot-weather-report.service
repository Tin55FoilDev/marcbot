[Unit]
Description=MarcBot weather report
Documentation=file:/srv/marcbot/app/docs/WEATHER_REPORT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=marc
Group=marc
WorkingDirectory=/srv/marcbot/app
ExecStart=/srv/marcbot/app/.venv/bin/python -m marcbot weather-report run-send-text

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/marcbot
